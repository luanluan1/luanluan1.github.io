---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);

const projects = [
	{
		title: 'RAG 知识检索与问答',
		description: '面向创投信息检索场景，处理多知识库接入、向量检索、缓存与 API 调度。',
		tags: ['RAGFlow', 'Dify', 'Python'],
	},
	{
		title: '会议转写与结构化总结',
		description: '组合语音转写、说话人处理与 LLM 总结，将会议内容整理为决策点和待办事项。',
		tags: ['ASR', 'LLM', '工作流'],
	},
	{
		title: '数据采集与治理工具',
		description: '用 Playwright、Pandas 和定时任务建立数据采集、清洗、匹配与结构化存储流程。',
		tags: ['Playwright', 'Pandas', '数据工程'],
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="page-shell home-page">
			<section class="hero" aria-labelledby="hero-title">
				<p class="eyebrow">AI APPLICATION ENGINEER / GUANGZHOU</p>
				<h1 id="hero-title">陈梓聪</h1>
				<p class="hero-lead">
					我做 AI 应用交付与开发，正在把“功能能跑”推进到可评测、可观测、可恢复的工程系统。
				</p>
				<div class="hero-actions">
					<a class="button primary" href="/projects">查看项目</a>
					<a class="button secondary" href="/blog">阅读文章</a>
				</div>
			</section>

			<section class="focus-band" aria-labelledby="focus-title">
				<div class="section-heading">
					<p class="eyebrow">CURRENT FOCUS</p>
					<h2 id="focus-title">从模型调用到业务可靠性</h2>
				</div>
				<div class="system-map" role="img" aria-label="业务请求经过 Agent、RAG 和安全校验进入业务系统">
					<div class="map-node"><span>01</span><strong>业务请求</strong></div>
					<span class="map-arrow" aria-hidden="true">→</span>
					<div class="map-node accent-blue"><span>02</span><strong>Agent 编排</strong></div>
					<span class="map-arrow" aria-hidden="true">→</span>
					<div class="map-node accent-yellow"><span>03</span><strong>RAG / 工具</strong></div>
					<span class="map-arrow" aria-hidden="true">→</span>
					<div class="map-node accent-green"><span>04</span><strong>权限与状态</strong></div>
					<span class="map-arrow" aria-hidden="true">→</span>
					<div class="map-node"><span>05</span><strong>业务系统</strong></div>
				</div>
			</section>

			<section class="section-block" aria-labelledby="projects-title">
				<div class="section-heading split-heading">
					<div>
						<p class="eyebrow">SELECTED WORK</p>
						<h2 id="projects-title">代表项目</h2>
					</div>
					<a class="text-link" href="/projects">全部项目 →</a>
				</div>
				<div class="project-grid">
					{projects.map((project, index) => (
						<article class="project-card">
							<p class="card-index">0{index + 1}</p>
							<h3>{project.title}</h3>
							<p>{project.description}</p>
							<ul class="tag-list" aria-label="技术栈">
								{project.tags.map((tag) => <li>{tag}</li>)}
							</ul>
						</article>
					))}
				</div>
			</section>

			<section class="section-block" aria-labelledby="notes-title">
				<div class="section-heading split-heading">
					<div>
						<p class="eyebrow">FIELD NOTES</p>
						<h2 id="notes-title">最新文章</h2>
					</div>
					<a class="text-link" href="/blog">全部文章 →</a>
				</div>
				<div class="post-list">
					{latestPosts.map((post) => (
						<a class="post-row" href={`/blog/${post.id}/`}>
							<div>
								<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</div>
							<span aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

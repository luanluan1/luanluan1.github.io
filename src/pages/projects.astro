---
import { Icon } from "astro-icon/components";
import { projects } from "@/data/projects";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout
	title="项目"
	description="AI 应用开发、知识检索、内容工作流与多模态集成项目"
>
	<div class="project-index" data-pagefind-body>
		<header class="card-base project-intro">
			<p class="project-eyebrow">SELECTED WORK · 2026</p>
			<div class="project-intro-row">
				<div>
					<h2>项目与实践</h2>
					<p>
						这里按实际参与边界记录项目。工作项目、自主开发与开源二次开发分别标明，重点说明我解决了什么问题。
					</p>
				</div>
				<div class="project-count" aria-label={`共 ${projects.length} 个项目`}>
					<strong>{String(projects.length).padStart(2, "0")}</strong>
					<span>PROJECTS</span>
				</div>
			</div>
		</header>

		<nav class="project-jump" aria-label="项目快速导航">
			{projects.map((project) => (
				<a href={`#${project.slug}`}>
					<span>{project.number}</span>
					{project.title}
				</a>
			))}
		</nav>

		<section class="project-list" aria-label="项目列表">
			{projects.map((project) => (
				<article id={project.slug} class="card-base project-item">
					<header class="project-heading">
						<div class="project-number">{project.number}</div>
						<div class="project-title-wrap">
							<p class="project-kind">{project.kind}</p>
							<h2>{project.title}</h2>
							<p class="project-summary">{project.shortDescription}</p>
						</div>
					</header>

					<div class="project-details">
						<section>
							<h3>业务背景</h3>
							<p>{project.context}</p>
						</section>
						<section>
							<h3>实际工作</h3>
							<p>{project.work}</p>
						</section>
						<section class="project-highlight">
							<h3>工程亮点</h3>
							<p>{project.highlight}</p>
						</section>
					</div>

					{project.images && (
						<div class="project-gallery" aria-label={`${project.title} 截图`}>
							{project.images.map((image, index) => (
								<figure class:list={{ "gallery-featured": index === 0 }}>
									<a href={image.src} target="_blank" aria-label={`查看大图：${image.caption}`}>
										<img src={image.src} alt={image.alt} loading="lazy" />
									</a>
									<figcaption>{image.caption}</figcaption>
								</figure>
							))}
						</div>
					)}

					<footer class="project-footer">
						<ul aria-label="技术栈">
							{project.stack.map((item) => <li>{item}</li>)}
						</ul>
						{project.links.length > 0 && (
							<div class="project-links">
								{project.links.map((link) => (
									<a href={link.href} target="_blank" rel="noreferrer">
										{link.label}
										<Icon name="material-symbols:arrow-outward-rounded" />
									</a>
								))}
							</div>
						)}
					</footer>
				</article>
			))}
		</section>
	</div>
</MainGridLayout>

<style>
	.project-index {
		display: grid;
		gap: 1rem;
	}

	.project-intro,
	.project-item {
		padding: clamp(1.25rem, 3vw, 2.25rem);
	}

	.project-eyebrow,
	.project-kind {
		margin: 0;
		color: var(--primary);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0;
	}

	.project-intro-row {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
	}

	.project-intro h2 {
		margin: 0.45rem 0 0.6rem;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.08;
	}

	.project-intro p:last-child {
		max-width: 46rem;
		margin: 0;
		color: var(--text-color-secondary);
		line-height: 1.75;
	}

	.project-count {
		display: grid;
		min-width: 6rem;
		color: var(--primary);
		text-align: right;
	}

	.project-count strong {
		font-size: 2.4rem;
		line-height: 1;
	}

	.project-count span {
		font-size: 0.65rem;
		font-weight: 700;
	}

	.project-jump {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		padding: 0.2rem 0 0.5rem;
		scrollbar-width: thin;
	}

	.project-jump a {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.45rem;
		padding: 0.55rem 0.8rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.5rem;
		background: var(--card-bg);
		color: var(--text-color-secondary);
		font-size: 0.78rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.project-jump a:hover {
		border-color: var(--primary);
		color: var(--primary);
	}

	.project-jump span {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	.project-list {
		display: grid;
		gap: 1rem;
	}

	.project-item {
		scroll-margin-top: 6rem;
	}

	.project-heading {
		display: grid;
		grid-template-columns: 3.25rem minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}

	.project-number {
		color: var(--primary);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 1.05rem;
		font-weight: 700;
	}

	.project-title-wrap h2 {
		margin: 0.3rem 0 0.65rem;
		font-size: clamp(1.4rem, 3vw, 2rem);
		line-height: 1.22;
	}

	.project-summary {
		max-width: 56rem;
		margin: 0;
		color: var(--text-color-secondary);
		font-size: 1rem;
		line-height: 1.7;
	}

	.project-details {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 1.6rem 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line-divider);
	}

	.project-details section {
		padding-right: 1rem;
	}

	.project-details section:not(:last-child) {
		border-right: 1px solid var(--line-divider);
	}

	.project-details h3 {
		margin: 0 0 0.5rem;
		font-size: 0.8rem;
	}

	.project-details p {
		margin: 0;
		color: var(--text-color-secondary);
		font-size: 0.88rem;
		line-height: 1.72;
	}

	.project-highlight h3 {
		color: var(--primary);
	}

	.project-gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
		margin: 1.5rem 0;
	}

	.project-gallery figure {
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--line-divider);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--card-bg) 88%, var(--primary) 12%);
	}

	.project-gallery .gallery-featured {
		grid-column: 1 / -1;
	}

	.project-gallery a {
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--page-bg);
	}

	.project-gallery img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.25s ease;
	}

	.project-gallery a:hover img {
		transform: scale(1.015);
	}

	.project-gallery figcaption {
		padding: 0.65rem 0.8rem;
		color: var(--text-color-secondary);
		font-size: 0.75rem;
	}

	.project-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line-divider);
	}

	.project-footer ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-footer li {
		padding: 0.3rem 0.6rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.project-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--primary);
		font-size: 0.8rem;
		font-weight: 700;
		text-decoration: none;
	}

	.project-links :global(svg) {
		width: 1rem;
		height: 1rem;
	}

	@media (max-width: 900px) {
		.project-details {
			grid-template-columns: 1fr;
		}

		.project-details section {
			padding-right: 0;
		}

		.project-details section:not(:last-child) {
			padding-bottom: 1rem;
			border-right: 0;
			border-bottom: 1px solid var(--line-divider);
		}
	}

	@media (max-width: 640px) {
		.project-intro-row {
			align-items: start;
		}

		.project-count {
			display: none;
		}

		.project-heading {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}

		.project-number {
			font-size: 0.8rem;
		}

		.project-gallery {
			grid-template-columns: 1fr;
		}

		.project-gallery .gallery-featured {
			grid-column: auto;
		}

		.project-gallery a {
			aspect-ratio: 4 / 3;
		}

		.project-footer {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
